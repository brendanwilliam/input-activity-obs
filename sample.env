# Copy this file to .env for standalone League Game Report development.
# Never commit .env or a real Riot API key.
RIOT_API_KEY=replace-with-your-riot-development-key
RIOT_ID="Name#TAG"

# Optional: proxy the dev UI to a report server currently running in OBS.
# REPORT_API_ORIGIN=http://127.0.0.1:49152

# Optional: change the browser preview port from its default of 4173.
# REPORT_DEV_PORT=4174
